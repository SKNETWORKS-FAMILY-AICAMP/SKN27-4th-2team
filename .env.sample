#################
# API KEY
# OpenAI API key for embedding/PostgreSQL pgvector build.
# Fill this value before running database/tools/build_pgvector_db.py.
#################
OPENAI_API_KEY=""

# Recommended default. Use text-embedding-3-large if you prefer quality over cost/speed.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# PostgreSQL + pgvector settings for Docker/DBeaver.
POSTGRES_DB=pet_dog
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5433